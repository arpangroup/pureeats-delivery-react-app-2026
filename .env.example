# Copy this file to .env.local (gitignored) to override defaults for local dev.

# 'mock' (default, no backend needed) or 'live' (talks to the real Spring Boot backend).
VITE_DATA_SOURCE=mock

# Base URL of the backend API - note the /api/v1 path (not /api).
VITE_API_BASE_URL=http://localhost:8081/api/v1

# Simulated network latency (ms) for mock-mode service calls.
VITE_MOCK_DELAY_MS=350

# Firebase project config for push notifications (order-assignment alerts). Leave empty to disable
# push entirely - the app falls back to polling for new orders (see useAvailableOrdersPolling).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
