# Production environment — talks to the real PureEats API at api.pureeats.in.
# Vite loads this automatically for `vite build` (no --mode flag needed;
# "production" is the default build mode), which is exactly what
# `npm run build` — and .github/workflows/deploy.yml — already run.
VITE_DATA_SOURCE=live
VITE_API_BASE_URL=https://api.pureeats.in/api/v1
VITE_MOCK_DELAY_MS=0
